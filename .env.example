# Copier vers .env.local et remplir. .env.local n'est jamais versionné.
#
# ⚠️  La clé de service Firebase donne un accès administrateur complet au
#     projet : elle contourne toutes les règles de sécurité. Jamais dans le
#     dépôt, jamais collée dans une conversation, jamais côté navigateur.

# ---------------------------------------------------------------------------
# Adresse publique du site
# ---------------------------------------------------------------------------
# Sert de base aux URL canoniques, au sitemap et aux images de partage.
# Doit inclure le protocole et correspondre au domaine réellement servi
# (celui vers lequel l'autre redirige en 301).
NEXT_PUBLIC_SITE_URL=https://www.sagaconsultants.ca

# ---------------------------------------------------------------------------
# Firebase — SDK admin (serveur uniquement)
# Console Firebase → Paramètres du projet → Comptes de service →
# Générer une nouvelle clé privée. Reprendre trois champs du JSON téléchargé.
# La clé privée contient des sauts de ligne : les garder échappés en \n et
# entourer la valeur de guillemets doubles.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=saga-consultants
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# Facultatif : déduit de FIREBASE_PROJECT_ID si absent.
# FIREBASE_STORAGE_BUCKET=saga-consultants.firebasestorage.app

# ---------------------------------------------------------------------------
# SendGrid — envoi des courriels (serveur uniquement)
# app.sendgrid.com → Settings → API Keys (portée « Mail Send » suffit).
# L'expéditeur doit appartenir à un domaine authentifié chez SendGrid.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sagaconsultants.ca
SENDGRID_FROM_NAME="SAGA Consultants"
# Destinataire interne des demandes du formulaire de contact
CONTACT_TO_EMAIL=info@sagaconsultants.ca
# Gabarits dynamiques SendGrid (facultatif — sinon le HTML intégré est utilisé)
SENDGRID_TEMPLATE_CONTACT_INTERNAL=
SENDGRID_TEMPLATE_CONTACT_ACK=

# ---------------------------------------------------------------------------
# Espace privé (/admin) — mot de passe partagé
# ---------------------------------------------------------------------------
# Sans valeur, l'espace privé reste inaccessible.
ADMIN_PASSWORD=
# Signe le cookie de session. En changer invalide toutes les sessions ouvertes.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=
